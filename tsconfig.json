{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2024",
      "esnext.array",
      "esnext.collection",
      "esnext.iterator",
      "dom"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"]
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules", "test", "coverage"]
}
